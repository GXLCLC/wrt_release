# TARGET config
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_ROOTFS_CPIOGZ=n

# Image Options
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# Kernel modules
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tls=y
CONFIG_PACKAGE_kmod-tun=y
#  USB Support
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-sierrawireless=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y

# Package
CONFIG_PACKAGE_ntfs3-mount=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_smartmontools-drivedb=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_usbmuxd=y
CONFIG_PACKAGE_xz-utils=y

# Enable Luci App
CONFIG_PACKAGE_luci-app-adguardhome=y
# 2026-11-09：X86_64 需要 AdGuard Home 二进制核心，由 n 改为 y。
# 依赖的 adguardhome 包已由 custom_feed 从 kenzok8/small-package 同步。
CONFIG_PACKAGE_luci-app-adguardhome_INCLUDE_binary=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-bandix=y
CONFIG_PACKAGE_luci-app-dockerman=y

# 2026-11-09 X86_64 补齐插件（仅本设备配置生效；SmartDNS / OAF / Bandix 已存在，不重复添加）
# DDNSTO：源码已由 custom_feed 从 kenzok8/small-package 同步（ddnsto + luci-app-ddnsto）。
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-app-ddnsto=y
# Mwan3：源码由 update_mwan3_fw4() 从 dl12345/mwan3 与 dl12345/luci-app-mwan3 同步（openwrt-25.12 分支）。
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
# Turboacc：上游 immortalwrt/luci 未收录，改由 custom_feed 从 chenmozhijin/turboacc 的 luci 分支同步。
# 关闭依赖非官方内核模块的选项（kmod-nft-fullcone、Shortcut-FE 系列），保留可提供的 Flow Offload 与 BBR。
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_NFT_FULLCONE=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_CM=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_DRV=n
