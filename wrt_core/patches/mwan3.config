# 2026-11-09：Mwan3 默认配置（按需求清空接口 / 成员 / 策略，仅保留规则）。
# 来源：https://github.com/dl12345/mwan3 的 openwrt-25.12 分支
#       files/etc/config/mwan3；由 update_mwan3_fw4() 克隆源码后覆盖写入。
# 上游默认含 4 个接口（wan / wan6 / wanb / wanb6）、10 个 member 段与
# 5 个 policy 段，本轮全部删除，留空由用户在 LuCI「MultiWAN 管理器」中自行配置。
# globals 段是 mwan3 init 读取 mmx_mask 等基础参数所必需，故保留。
# 3 个 rule 段保持上游原样（含 enabled=0 与 use_policy=balanced）；
# balanced 策略被清空后需先补配成员与策略再启用规则。
# 作用域说明：当前只有 x64_immwrt 选中 mwan3 / luci-app-mwan3，
# 因此最终固件中仅 X86_64 会带上这份配置。

config globals 'globals'
	option mmx_mask '0x3F00'

config rule 'https'
	option enabled '0'
	option sticky '1'
	option dest_port '443'
	option proto 'tcp'
	option use_policy 'balanced'

config rule 'default_rule_v4'
	option enabled '0'
	option dest_ip '0.0.0.0/0'
	option use_policy 'balanced'
	option family 'ipv4'

config rule 'default_rule_v6'
	option enabled '0'
	option dest_ip '::/0'
	option use_policy 'balanced'
	option family 'ipv6'
